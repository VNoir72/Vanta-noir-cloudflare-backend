{
  "name": "vanta-noir-cloudflare-backend",
  "version": "0.3.4",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node portable/build-backend.mjs",
    "build:storefront": "node portable/build.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "verify:release": "node portable/verify-backend.mjs",
    "verify:storefront": "node portable/verify-storefront.mjs",
    "deploy": "wrangler deploy --config wrangler.deploy.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
    "db:import-catalog": "wrangler d1 execute DB --remote --config wrangler.deploy.jsonc --file portable/catalog-import.sql",
    "db:upgrade": "node scripts/upgrade-database.mjs",
    "maintenance": "wrangler deploy scripts/maintenance-worker.js --config wrangler.deploy.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-slot": "1.3.3",
    "@shadcn/react": "^0.3.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.12",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "5.20260921.0-alpha",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.136.0"
  },
  "type": "module",
  "displayName": "Vanta Noir Store",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1": true,
    "workerd@1.20260921.1": true,
    "esbuild@0.28.1": true
  }
}
