Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://vantanoir.store%{REQUEST_URI} [R=301,L,NE]
# Keep the API on Cloudflare. There is no server-side application in public_html.
RewriteRule ^admin/?$ https://api.vantanoir.store/admin [R=302,L]
RewriteCond %{HTTP_HOST} ^www\.vantanoir\.store$ [NC]
RewriteRule ^ https://vantanoir.store%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^(about|contact|help-center|privacy-policy|privacy-choices|shipping-returns|terms-of-service|reviews|case-studies|email-preferences|checkout|checkout/complete)/$ /$1 [R=301,L]
RewriteRule ^(about|contact|help-center|privacy-policy|privacy-choices|shipping-returns|terms-of-service|reviews|case-studies|email-preferences|checkout|checkout/complete)$ $1.html [END]
RewriteRule ^products/([a-z0-9-]+)/$ /products/$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^products/([a-z0-9-]+)$ products/$1.html [END]
RewriteRule ^products/[a-z0-9-]+$ products/_dynamic.html [END]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(html|js)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(webp|png|svg|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
