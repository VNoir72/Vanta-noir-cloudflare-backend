Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# The brand introduction now lives on the homepage.
RewriteRule ^about(?:\.html|/index\.html)?/?$ /#brand [R=301,L,NE]
# The current release is the only homepage, including links to retired entry files.
RewriteRule ^(?:index\.(?:php|htm)|home(?:\.html)?)$ / [R=302,L]
# Canonical routes must win over old physical page directories.
RewriteCond %{THE_REQUEST} \s/+((?:about|contact|help-center|privacy-policy|privacy-choices|shipping-returns|terms-of-service|reviews|case-studies|email-preferences|checkout)(?:/complete)?)(?:/index\.html|\.html)[?\s] [NC]
RewriteRule ^ /%1 [R=302,L,NE]
# Never serve accidentally uploaded source, backups or credentials.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:backups|node_modules|drizzle|lib|app|tests|portable)(?:/|$) - [F,L,NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://vantanoir.store%{REQUEST_URI} [R=301,L,NE]
# The PHP visibility gateway reads public metadata only; the application stays on Cloudflare.
RewriteRule ^admin/?$ https://api.vantanoir.store/admin [R=302,L]
RewriteCond %{HTTP_HOST} ^www\.vantanoir\.store$ [NC]
RewriteRule ^ https://vantanoir.store%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^$ index.html [END]
RewriteRule ^(about|contact|help-center|privacy-policy|privacy-choices|shipping-returns|terms-of-service|reviews|case-studies|email-preferences|checkout|checkout/complete)/$ /$1 [R=301,L]
RewriteRule ^(about|contact|help-center|privacy-policy|privacy-choices|shipping-returns|terms-of-service|reviews|case-studies|email-preferences|checkout|checkout/complete)$ $1.html [END]
# Check publication on every product URL, including old .html links.
RewriteRule ^products/[a-z0-9_-]+(?:\.html)?/?$ storefront-gateway.php [END]
RewriteRule ^sitemap\.xml$ storefront-gateway.php [END]
</IfModule>

<FilesMatch "(?i)(?:^\.env(?:\..*)?$|^package(?:-lock)?\.json$|^wrangler.*\.jsonc?$|\.(?:sql|sqlite|sqlite3|db|cjs|map|zip|bak)$)">
Require all denied
</FilesMatch>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(html|js)$">
Header always set Cache-Control "no-store, max-age=0"
</FilesMatch>
<FilesMatch "\.(css|webp|png|svg|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
# Vite content-hashed assets can be reused until their filename changes.
<FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
