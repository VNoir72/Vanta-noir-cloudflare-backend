{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "customer"
      },
      "ios": {
        "image": "latest"
      },
      "autoIncrement": true
    },
    "studio-preview": {
      "channel": "studio-preview",
      "extends": "preview",
      "env": {
        "APP_VARIANT": "studio"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "customer"
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "channel": "production"
    },
    "studio-production": {
      "channel": "studio-production",
      "extends": "production",
      "env": {
        "APP_VARIANT": "studio"
      }
    }
  }
}
