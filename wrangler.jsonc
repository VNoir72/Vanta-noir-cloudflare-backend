{
  "name": "vanta-noir-api",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vanta-noir-db",
      "database_id": "db5dccad-083a-4c80-bc7c-63cba3a00a35",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "vanta-noir-media"
    }
  ],
  "vars": {
    "AUTH_PROVIDER": "cloudflare-access",
    "STOREFRONT_URL": "https://vantanoir.store",
    "ALLOWED_ORIGINS": "https://vantanoir.store,https://www.vantanoir.store"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
